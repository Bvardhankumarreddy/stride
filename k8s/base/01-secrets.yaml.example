# IMPORTANT: Copy this file to 01-secrets.yaml and fill in real values.
# 01-secrets.yaml is gitignored and must NEVER be committed.
# Uses stringData — Kubernetes handles base64 encoding automatically.

apiVersion: v1
kind: Secret
metadata:
  name: stride-secrets
  namespace: stride
type: Opaque
stringData:
  # Database
  POSTGRES_PASSWORD:       "change-me"

  # Redis (BullMQ job queues)
  REDIS_PASSWORD:          "change-me"

  # Auth
  JWT_SECRET:              "run: openssl rand -hex 32"
  JWT_REFRESH_SECRET:      "run: openssl rand -hex 32"
  NEXTAUTH_SECRET:         "run: openssl rand -hex 32"   # same value used as AUTH_SECRET build arg

  # AI
  ANTHROPIC_API_KEY:       "sk-ant-..."

  # Email Lambda
  EMAIL_LAMBDA_API_KEY:    "from Lambda env vars"

  # Typesense (from Typesense Cloud dashboard)
  TYPESENSE_API_KEY:       "your-typesense-api-key"

  # Liveblocks (from liveblocks.io dashboard → API Keys)
  LIVEBLOCKS_SECRET_KEY:   "sk_live_..."

  # OAuth
  GOOGLE_CLIENT_ID:        "from Google Console"
  GOOGLE_CLIENT_SECRET:    "from Google Console"
  GITHUB_CLIENT_ID:        "from GitHub"
  GITHUB_CLIENT_SECRET:    "from GitHub"

  # Stripe billing
  STRIPE_SECRET_KEY:       "sk_live_..."
  STRIPE_WEBHOOK_SECRET:   "whsec_..."
