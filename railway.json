{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "Stride-Backend": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "api/Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    },
    "Stride-Frontend": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "app/Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    }
  }
}
