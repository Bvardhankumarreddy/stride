# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stride"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Redis (jobs/queues) ───────────────────────────────────────────────────────
# Upstash free tier: https://upstash.com
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Typesense (search) ────────────────────────────────────────────────────────
# Set SEARCH_ENABLED=true to activate Typesense search. When false (default),
# the app starts without connecting to Typesense and all search calls are no-ops.
# Typesense Cloud free tier: https://cloud.typesense.org
SEARCH_ENABLED=false
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=your-typesense-api-key

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5001
