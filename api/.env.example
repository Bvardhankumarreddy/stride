# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stride"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Frontend URL — used in email links and OAuth redirects
APP_URL="http://localhost:3001"

# ── Redis (jobs/queues) ───────────────────────────────────────────────────────
# Upstash free tier: https://upstash.com (optional — degrades gracefully)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Typesense (search) ────────────────────────────────────────────────────────
# Typesense Cloud free tier: https://cloud.typesense.org (optional — falls back to Prisma)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=your-typesense-api-key

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Email (Website → Lambda → SES) ───────────────────────────────────────────
EMAIL_LAMBDA_URL=https://your-lambda.amazonaws.com/send
EMAIL_LAMBDA_API_KEY=your-lambda-api-key

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# Callback URL: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub: https://github.com/settings/developers → OAuth Apps
# Callback URL: APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
